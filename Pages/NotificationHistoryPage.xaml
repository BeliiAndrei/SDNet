<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:SDNet.PageModels"
             xmlns:models="clr-namespace:SDNet.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SDNet.Pages.NotificationHistoryPage"
             x:DataType="pageModels:NotificationHistoryPageModel"
             x:Name="NotificationHistoryRoot"
             Title="История уведомлений">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference NotificationHistoryRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <VerticalStackLayout Padding="{StaticResource LayoutPadding}" Spacing="{StaticResource LayoutSpacing}">
        <Button Text="Обновить" Command="{Binding ReloadCommand}" />
        <Label Text="{Binding StatusMessage}" Style="{StaticResource Body2Strong}" />
        <CollectionView ItemsSource="{Binding Notifications}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NotificationMessage">
                    <Border Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Subject}" Style="{StaticResource Body2Strong}" />
                            <Label Text="{Binding Body}" Style="{StaticResource Caption1}" />
                            <Label Text="{Binding RecipientName, StringFormat='Получатель: {0}'}" Style="{StaticResource Caption1}" />
                            <Label Text="{Binding CreatedAt, StringFormat='Отправлено: {0:dd.MM.yyyy HH:mm}'}" Style="{StaticResource Caption1}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
